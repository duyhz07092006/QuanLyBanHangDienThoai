@model List<QuanLyBanHangDienThoai.Models.GioHangItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    decimal tongTien = Model.Sum(x => x.ThanhTien);
}

<div class="container mt-4 mb-5">
    <h2>Giỏ hàng của tôi</h2>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success">@TempData["ThongBao"]</div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger">@TempData["Loi"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Giỏ hàng đang trống.</div>
        <a asp-controller="DienThoai" asp-action="Index"
           class="btn btn-primary">Tiếp tục mua sắm</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Điện thoại</th>
                        <th>Đơn giá</th>
                        <th style="width:180px">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Xóa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                {
                                    <img src="@Url.Content(QuanLyBanHangDienThoai.Services.AnhSanPham.DuongDan(item.HinhAnh)!)" alt="@item.TenDT"
                                         style="width:70px;height:70px;object-fit:contain" />
                                }
                                @item.TenDT
                            </td>
                            <td>@item.DonGia.ToString("N0") đ</td>
                            <td>
                                <form asp-action="CapNhat" method="post"
                                      class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.MaDT" />
                                    <input type="number" name="soLuong"
                                           value="@item.SoLuong" min="0"
                                           class="form-control" />
                                    <button class="btn btn-warning btn-sm"
                                            type="submit">Cập nhật</button>
                                </form>
                            </td>
                            <td>@item.ThanhTien.ToString("N0") đ</td>
                            <td>
                                <form asp-action="Xoa" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.MaDT" />
                                    <button class="btn btn-danger btn-sm"
                                            type="submit">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Tổng tiền:</th>
                        <th colspan="2">@tongTien.ToString("N0") đ</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-controller="DienThoai" asp-action="Index"
               class="btn btn-outline-secondary">Tiếp tục mua sắm</a>

            <a asp-action="DatHang" asp-controller="GioHang"
               class="btn btn-success">Tiến hành đặt hàng</a>
        </div>
    }
</div>