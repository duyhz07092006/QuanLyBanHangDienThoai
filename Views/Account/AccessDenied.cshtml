@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container mt-5" style="max-width: 560px;">
    <div class="alert alert-danger border-0 shadow-sm">
        <h4 class="alert-heading"><i class="fa-solid fa-lock me-2"></i>Không có quyền truy cập</h4>
        <p class="mb-0">Tài khoản của bạn không có quyền sử dụng chức năng này. Nếu cần, hãy liên hệ quản trị viên.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Về trang chủ
    </a>
</div>
