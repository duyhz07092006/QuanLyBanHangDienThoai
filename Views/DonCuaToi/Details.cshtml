@model QuanLyBanHangDienThoai.Models.DonHang
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    bool coTheHuy = Model.TrangThai == "Chờ xử lý";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Đơn hàng @($"#DH0{Model.MaDH}")</h2>
            <span class="text-muted">Đặt lúc @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>

    @if (TempData["ThongBao"] is string thongBaoOk)
    {
        <div class="alert alert-success">@thongBaoOk</div>
    }
    @if (TempData["Loi"] is string thongBaoLoi)
    {
        <div class="alert alert-danger">@thongBaoLoi</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Sản phẩm</strong></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th class="text-end">Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTiet)
                            {
                                <tr>
                                    <td>@(ct.DienThoai?.TenDT ?? "(sản phẩm đã bị xóa)")</td>
                                    <td>@ct.DonGia.ToString("N0") ₫</td>
                                    <td>@ct.SoLuong</td>
                                    <td class="text-end">@((ct.DonGia * ct.SoLuong).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tổng cộng</th>
                                <th class="text-end text-primary">@Model.TongTien.ToString("N0") ₫</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Thông tin giao hàng</strong></div>
                <div class="card-body">
                    <div class="mb-2"><small class="text-muted d-block">Người nhận</small>@Model.TenNguoiNhan</div>
                    <div class="mb-2"><small class="text-muted d-block">Số điện thoại</small>@Model.SdtNguoiNhan</div>
                    <div class="mb-2"><small class="text-muted d-block">Địa chỉ</small>@Model.DiaChiGiaoHang</div>
                    <div class="mb-2"><small class="text-muted d-block">Thanh toán</small>@Model.PhuongThucTT</div>
                    <div>
                        <small class="text-muted d-block">Trạng thái</small>
                        <span class="badge @(Model.TrangThai == "Hoàn thành" ? "bg-success" : Model.TrangThai == "Đang giao" ? "bg-warning text-dark" : Model.TrangThai == "Đã hủy" ? "bg-danger" : "bg-info text-dark")">@Model.TrangThai</span>
                    </div>
                </div>
            </div>

            @if (coTheHuy)
            {
                <form asp-action="Huy" asp-route-id="@Model.MaDH" method="post" class="mt-3"
                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                    <button type="submit" class="btn btn-outline-danger w-100">Hủy đơn hàng</button>
                </form>
            }
            else
            {
                <p class="text-muted small mt-3 mb-0">Chỉ hủy được đơn ở trạng thái "Chờ xử lý".</p>
            }
        </div>
    </div>
</div>
