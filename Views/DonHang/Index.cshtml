@model IEnumerable<QuanLyBanHangDienThoai.Models.DonHang>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0"><i class="fa-solid fa-receipt text-success me-2"></i> Danh sách Đơn hàng</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã Đơn</th>
                        <th>Người Nhận</th>
                        <th>SĐT</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@($"#DH0{item.MaDH}")</td>
                                <td>@item.TenNguoiNhan</td>
                                <td>@item.SdtNguoiNhan</td>
                                <td class="fw-bold text-primary">@string.Format("{0:N0} VNĐ", item.TongTien)</td>
                                <td>
                                    @if (item.TrangThai == "Hoàn thành")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else if (item.TrangThai == "Đang giao")
                                    {
                                        <span class="badge bg-warning text-dark">Đang giao</span>
                                    }
                                    else if (item.TrangThai == "Chờ xử lý")
                                    {
                                        <span class="badge bg-info text-dark">Chờ xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.MaDH" class="btn btn-sm btn-primary">
                                        <i class="fa-solid fa-circle-info"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>