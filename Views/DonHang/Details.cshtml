@model DonHang
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var buocTiep = TrangThaiDonHang.BuocTiepTheo(Model.TrangThai);
}

@if (TempData["SuccessMessage"] is string thongBaoOk)
{
    <div class="alert alert-success">@thongBaoOk</div>
}
@if (TempData["ErrorMessage"] is string thongBaoLoi)
{
    <div class="alert alert-warning">@thongBaoLoi</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Đơn hàng @($"#DH0{Model.MaDH}")</h3>
        <p class="text-muted mb-0">Đặt ngày @Model.NgayDat.ToString("dd/MM/yyyy")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">Sản phẩm trong đơn</h5></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th class="ps-4">Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th class="text-end pe-4">Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.ChiTiet)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.TenSanPham</td>
                                <td>@item.DonGia.ToString("N0") ₫</td>
                                <td>@item.SoLuong</td>
                                <td class="text-end pe-4">@((item.DonGia * item.SoLuong).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Tổng cộng</th><th class="text-end pe-4 text-primary">@Model.TongTien.ToString("N0") ₫</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">Thông tin giao hàng</h5></div>
            <div class="card-body">
                <div class="mb-3"><small class="text-muted d-block">Người nhận</small><strong>@Model.TenNguoiNhan</strong></div>
                <div class="mb-3"><small class="text-muted d-block">Số điện thoại</small><strong>@Model.SdtNguoiNhan</strong></div>
                <div class="mb-3"><small class="text-muted d-block">Địa chỉ</small><strong>@Model.DiaChiGiaoHang</strong></div>
                <div><small class="text-muted d-block mb-1">Trạng thái</small><span class="badge @(Model.TrangThai == "Hoàn thành" ? "bg-success" : Model.TrangThai == "Đang giao" ? "bg-warning text-dark" : Model.TrangThai == "Đã hủy" ? "bg-danger" : "bg-info text-dark")">@Model.TrangThai</span></div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-3 mt-3">
            <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">Xử lý đơn hàng</h5></div>
            <div class="card-body">
                @if (buocTiep.Count == 0)
                {
                    <p class="text-muted mb-0">Đơn hàng đã kết thúc, không thể đổi trạng thái.</p>
                }
                else
                {
                    <form asp-action="CapNhatTrangThai" asp-route-id="@Model.MaDH" method="post" class="d-grid gap-2">
                        @foreach (var tt in buocTiep)
                        {
                            if (tt == TrangThaiDonHang.DaHuy)
                            {
                                <button type="submit" name="trangThai" value="@tt" class="btn btn-outline-danger"
                                        onclick="return confirm('Hủy đơn hàng này? Số lượng sản phẩm sẽ được hoàn lại kho.');">
                                    <i class="fa-solid fa-ban me-1"></i> Hủy đơn hàng
                                </button>
                            }
                            else
                            {
                                <button type="submit" name="trangThai" value="@tt" class="btn btn-primary">
                                    <i class="fa-solid fa-arrow-right me-1"></i> Chuyển sang: @tt
                                </button>
                            }
                        }
                    </form>
                    <small class="text-muted d-block mt-2">Hủy đơn sẽ hoàn lại số lượng tồn kho.</small>
                }
            </div>
        </div>
    </div>
</div>