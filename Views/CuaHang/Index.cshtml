@model IEnumerable<StoreDienThoai>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Điện thoại chính hãng";
    var phones = Model.ToList();
    var brands = phones.Select(phone => phone.TenDM).Where(brand => !string.IsNullOrWhiteSpace(brand)).Distinct().OrderBy(brand => brand).ToList();
}

<section class="py-5" id="uu-dai" style="background: linear-gradient(120deg, #fff4ef 0%, #fff 58%, #f1f5ff 100%);">
    <div class="container py-lg-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="badge rounded-pill text-bg-danger-subtle text-danger px-3 py-2 mb-3">CÔNG NGHỆ MỚI · GIÁ TỐT MỖI NGÀY</span>
                <h1 class="display-4 fw-bold lh-sm mb-3">Chọn chiếc điện thoại <span class="text-danger">dành cho bạn</span></h1>
                <p class="fs-5 text-secondary mb-4">Khám phá những mẫu smartphone mới nhất, thông tin rõ ràng và sản phẩm được cập nhật trực tiếp từ cửa hàng.</p>
                <a class="btn btn-store btn-lg rounded-pill px-4" href="#san-pham">Khám phá sản phẩm <i class="fa-solid fa-arrow-right ms-2"></i></a>
                <div class="d-flex flex-wrap gap-4 mt-4 text-secondary small">
                    <span><i class="fa-solid fa-circle-check text-success me-2"></i>Hàng chính hãng</span>
                    <span><i class="fa-solid fa-truck-fast text-primary me-2"></i>Giao hàng toàn quốc</span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="rounded-5 p-4 p-lg-5 text-white overflow-hidden position-relative" style="background: linear-gradient(135deg, #202b43, #465779); min-height: 260px;">
                    <div class="position-relative" style="z-index: 1;">
                        <div class="text-uppercase small fw-semibold opacity-75 mb-2">PHONE STORE</div>
                        <h2 class="fw-bold display-6">Nâng cấp trải nghiệm<br />mỗi ngày</h2>
                        <p class="mb-0 opacity-75">Tìm chiếc máy phù hợp với phong cách và nhu cầu của bạn.</p>
                    </div>
                    <i class="fa-solid fa-mobile-screen-button position-absolute" aria-hidden="true" style="font-size: 15rem; right: 1rem; bottom: -4rem; transform: rotate(-12deg); opacity: .12;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5" id="san-pham">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="text-danger fw-semibold small text-uppercase">Dành cho bạn</span>
            <h2 class="fw-bold mb-1 mt-1">Điện thoại nổi bật</h2>
            <p class="text-secondary mb-0">Chọn thương hiệu yêu thích hoặc tìm mẫu máy bạn cần.</p>
        </div>
        <span class="text-secondary small"><span id="productCount">@phones.Count</span> sản phẩm</span>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Lọc theo thương hiệu">
        <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 brand-filter active" data-brand="">Tất cả</button>
        @foreach (var brand in brands)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 brand-filter" data-brand="@brand">@brand</button>
        }
    </div>

    @if (phones.Count == 0)
    {
        <div class="text-center rounded-4 bg-light py-5 px-3">
            <i class="fa-solid fa-mobile-screen-button text-secondary fs-1 mb-3"></i>
            <h3 class="h5 fw-bold">Cửa hàng đang cập nhật sản phẩm</h3>
            <p class="text-secondary mb-0">Vui lòng quay lại sau để khám phá các mẫu điện thoại mới.</p>
        </div>
    }
    else
    {
        <div class="row g-3 g-lg-4" id="productGrid">
            @foreach (var phone in phones)
            {
                var searchText = $"{phone.TenDT} {phone.TenDM} {phone.ManHinh} {phone.RAM} {phone.BoNho}";
                var duongDanAnh = QuanLyBanHangDienThoai.Services.AnhSanPham.DuongDan(phone.HinhAnh);
                var imageUrl = duongDanAnh is null ? null : Url.Content(duongDanAnh);
                <div class="col-6 col-md-4 col-xl-3 product-item" data-brand="@phone.TenDM" data-search="@searchText">
                    <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                        <div class="product-image position-relative d-flex align-items-center justify-content-center bg-light">
                            <i class="product-placeholder fa-solid fa-mobile-screen-button text-secondary" aria-hidden="true"></i>
                            @if (imageUrl is not null)
                            {
                                <img src="@imageUrl" alt="@phone.TenDT" loading="lazy" />
                            }
                            <span class="badge rounded-pill @(phone.SoLuongTon > 0 ? "text-bg-success" : "text-bg-secondary") position-absolute top-0 start-0 m-3">
                                @(phone.SoLuongTon > 0 ? "Còn hàng" : "Tạm hết")
                            </span>
                        </div>
                        <div class="card-body p-3 p-lg-4 d-flex flex-column">
                            <span class="text-secondary small mb-1">@phone.TenDM</span>
                            <h3 class="h6 fw-bold mb-2 product-name">@phone.TenDT</h3>
                            <div class="text-danger fw-bold fs-5 mb-3">@phone.Gia.ToString("N0") ₫</div>
                            <div class="product-specs text-secondary small mt-auto">
                                @if (!string.IsNullOrWhiteSpace(phone.ManHinh))
                                {
                                    <span><i class="fa-solid fa-display me-1"></i>@phone.ManHinh</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(phone.RAM) || !string.IsNullOrWhiteSpace(phone.BoNho))
                                {
                                    <span><i class="fa-solid fa-memory me-1"></i>@phone.RAM @(!string.IsNullOrWhiteSpace(phone.RAM) && !string.IsNullOrWhiteSpace(phone.BoNho) ? "·" : "") @phone.BoNho</span>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a asp-controller="DienThoai" asp-action="Details" asp-route-id="@phone.MaDT"
                                   class="btn btn-outline-dark btn-sm flex-fill">Xem chi tiết</a>
                                @if (phone.SoLuongTon <= 0)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm flex-fill" disabled>Tạm hết</button>
                                }
                                else if (User.IsInRole("KhachHang"))
                                {
                                    <form asp-controller="GioHang" asp-action="Them" method="post" class="flex-fill d-flex">
                                        <input type="hidden" name="id" value="@phone.MaDT" />
                                        <input type="hidden" name="soLuong" value="1" />
                                        <button type="submit" class="btn btn-store btn-sm flex-fill">
                                            <i class="fa-solid fa-cart-plus me-1"></i>Thêm vào giỏ
                                        </button>
                                    </form>
                                }
                                else if (User.Identity?.IsAuthenticated != true)
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "CuaHang")"
                                       class="btn btn-store btn-sm flex-fill">Đăng nhập để mua</a>
                                }
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
        <div id="emptySearch" class="d-none text-center rounded-4 bg-light py-5 px-3 mt-3">
            <i class="fa-solid fa-magnifying-glass text-secondary fs-1 mb-3"></i>
            <h3 class="h5 fw-bold">Không tìm thấy sản phẩm phù hợp</h3>
            <p class="text-secondary mb-0">Thử từ khóa hoặc thương hiệu khác nhé.</p>
        </div>
    }
</section>

<section class="container pb-5">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="rounded-4 bg-light p-4 h-100">
                <i class="fa-solid fa-certificate text-danger fs-4 mb-3"></i>
                <h3 class="h6 fw-bold">Sản phẩm minh bạch</h3>
                <p class="text-secondary small mb-0">Giá bán, cấu hình và tình trạng hàng được hiển thị rõ ràng.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rounded-4 bg-light p-4 h-100">
                <i class="fa-solid fa-truck-fast text-primary fs-4 mb-3"></i>
                <h3 class="h6 fw-bold">Mua sắm thuận tiện</h3>
                <p class="text-secondary small mb-0">Dễ dàng tìm kiếm và khám phá điện thoại theo thương hiệu.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rounded-4 bg-light p-4 h-100">
                <i class="fa-solid fa-headset text-success fs-4 mb-3"></i>
                <h3 class="h6 fw-bold">Luôn sẵn sàng hỗ trợ</h3>
                <p class="text-secondary small mb-0">Liên hệ cửa hàng để được tư vấn thêm về sản phẩm phù hợp.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const searchInput = document.getElementById('productSearch');
        const productItems = Array.from(document.querySelectorAll('.product-item'));
        const filterButtons = Array.from(document.querySelectorAll('.brand-filter'));
        const emptySearch = document.getElementById('emptySearch');
        const productCount = document.getElementById('productCount');
        let selectedBrand = '';

        document.querySelectorAll('.product-image img').forEach(image => {
            image.addEventListener('error', () => {
                image.hidden = true;
            });
        });

        function updateProducts() {
            const query = searchInput.value.trim().toLocaleLowerCase('vi');
            let visibleCount = 0;

            productItems.forEach(item => {
                const matchesBrand = !selectedBrand || item.dataset.brand === selectedBrand;
                const matchesQuery = !query || item.dataset.search.toLocaleLowerCase('vi').includes(query);
                const isVisible = matchesBrand && matchesQuery;
                item.classList.toggle('d-none', !isVisible);
                visibleCount += isVisible ? 1 : 0;
            });

            productCount.textContent = visibleCount;
            if (emptySearch) {
                emptySearch.classList.toggle('d-none', visibleCount > 0);
            }
        }

        searchInput.addEventListener('input', updateProducts);
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedBrand = button.dataset.brand;
                filterButtons.forEach(filter => {
                    const isSelected = filter === button;
                    filter.classList.toggle('active', isSelected);
                    filter.classList.toggle('btn-dark', isSelected);
                    filter.classList.toggle('btn-outline-secondary', !isSelected);
                });
                updateProducts();
            });
        });
    </script>
    <style>
        .product-card {
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 2rem rgb(23 32 51 / 10%) !important;
        }

        .product-image {
            aspect-ratio: 1 / .82;
            overflow: hidden;
        }

        .product-image img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 1.25rem;
        }

        .product-image img[hidden] {
            display: none;
        }

        .product-placeholder {
            font-size: 5rem;
            opacity: .22;
        }

        .product-specs {
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }

        .brand-filter.active {
            color: #fff;
            background: #212529;
            border-color: #212529;
        }
    </style>
}
